# ==========================================
# Friend Shield - Git Ignore Rules
# ==========================================

# 1. Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
backend/.env

# 2. Node Dependencies & Build Artifacts
node_modules/
*/node_modules/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 3. Machine Learning Datasets (Large CSV/Archive Files)
*.csv
*.tsv
*.parquet
*.feather
*.zip
*.tar.gz
*.gz
!frontend/tessdata/*.gz
ml-training/data/*.csv
ml-training/data/*.tsv
!ml-training/data/.gitkeep

# 4. Python Bytecode & Environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# 5. OS & Editor Cache Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 6. Logs & Temporary Scratch Files
logs/
*.log
scratch/
temp/
tmp/
