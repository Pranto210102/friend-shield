# Server Port
PORT=8000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Safe Browsing API Key (v4)
# Get a free key at: https://console.cloud.google.com/ (APIs & Services -> Safe Browsing API)
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# Open-Source AI: Google Gemma 2
# Option A (Recommended for Cloud Deployment): Free Cloud Open-Weights via Groq API
# Ultra-fast Gemma 2 (gemma2-9b-it) inference: ~300ms latency, zero server RAM overhead.
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option B (Local / Offline): Local Ollama (100% on-device privacy, no API key needed):
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma2:2b


