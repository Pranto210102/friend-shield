# Server Port
PORT=8000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Safe Browsing API Key (v4)
# Get a free key at: https://console.cloud.google.com/ (APIs & Services -> Safe Browsing API)
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# Open-Source AI: Google Qwen 2
# Option A (Cloud Inference via OpenAI-compatible endpoint, e.g. OpenRouter, Google AI Studio, Together AI):
AI_API_KEY=your_gemma_api_key_here
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b

# Option B (Local / Air-Gapped Privacy via Ollama - zero cloud calls, 100% offline):
OLLAMA_HOST=http://localhost:11434
AI_LOCAL_MODEL=gemma2:9b

# Option C (Zero-Config Offline Fallback):
# If neither cloud API key nor local Ollama daemon is active, Friend Shield returns
# deterministic template explanations (not generated by Qwen) to ensure a response is always available.


