# Server Port
PORT=8000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Safe Browsing API Key (v4)
# Get a free key at: https://console.cloud.google.com/ (APIs & Services -> Safe Browsing API)
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# ----------------------------------------------------------------------------
# Open-Weight AI (Google Gemma) Configuration
# Friend Shield supports Dual Deployment: Cloud Inference OR 100% Local Ollama
# ----------------------------------------------------------------------------

# Provider Strategy: 'auto' (default: uses cloud if key set, else local), 'ollama', or 'cloud'
AI_PROVIDER=auto

# Option A: Cloud Gemma Inference (Recommended for zero-friction mobile web users without GPUs)
# Compatible with Google AI Studio, Groq Cloud, OpenRouter, Together AI, etc.
AI_API_KEY=your_gemma_or_google_ai_studio_api_key_here
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemma-4-26b-a4b-it

# Option B: 100% Local / Air-Gapped Inference via Ollama (Zero data egress, complete privacy)
# 1. Install Ollama: https://ollama.com
# 2. Run: ollama run gemma2:2b (or gemma2:9b)
# 3. Set AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
AI_LOCAL_MODEL=gemma2:2b

# Option C: Zero-Config Offline Fallback
# If neither cloud API key nor local Ollama daemon is active, Friend Shield immediately returns
# deterministic security template explanations so the user is never left without safety advice.


