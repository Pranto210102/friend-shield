# Server Port
PORT=8000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Safe Browsing API Key (v4)
# Get a free key at: https://console.cloud.google.com/ (APIs & Services -> Safe Browsing API)
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# Open-Source AI: Gemma 2 (Local Ollama or Free Cloud Open-Weights)
# Option A: Local Ollama (100% on-device privacy, no API key needed):
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma2:2b

# Option B: Free Cloud Open-Weights via Groq API (ultra-fast Gemma 2 inference):
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option C: Google AI Studio (Gemma-2-9b-it / Gemini fallback):
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

